<%- include('partials/head') %>
<main id="main-content" class="shell page-space">
  <nav class="breadcrumbs" aria-label="Đường dẫn">
    <a href="/">Trang chủ</a><span>/</span><a href="/products">Sản phẩm</a><span>/</span><span><%= product.name %></span>
  </nav>

  <section class="detail-layout">
    <div class="detail-media"><img src="<%= product.image %>" alt="<%= product.name %>"></div>
    <div class="detail-copy">
      <p class="eyebrow"><%= product.category %> / <%= product.sku %></p>
      <h1><%= product.name %></h1>
      <p class="detail-summary"><%= product.summary %></p>
      <p class="detail-price tabular"><%= formatVnd(product.price) %></p>
      <div class="availability"><span class="status-dot <%= product.quantity ? '' : 'is-out' %>"></span><%= product.quantity ? `Còn ${product.quantity} sản phẩm` : 'Tạm hết hàng' %></div>
      <div class="detail-actions">
        <button class="button button-dark" type="button" <%= product.quantity ? '' : 'disabled' %>>Thêm vào giỏ</button>
        <a class="button button-outline" href="/admin/products/<%= product._id %>/edit">Chỉnh sửa</a>
      </div>
      <div class="detail-description">
        <h2>Chi tiết thiết kế</h2><p><%= product.description %></p>
      </div>
      <dl class="spec-list">
        <div><dt>Chất liệu</dt><dd><%= product.material %></dd></div>
        <div><dt>Màu sắc</dt><dd><%= product.color %></dd></div>
        <div><dt>Kích thước</dt><dd><%= product.dimensions %></dd></div>
      </dl>
    </div>
  </section>

  <% if (related.length) { %>
    <section class="section related-section">
      <div class="section-heading"><div><p class="eyebrow">CÙNG DANH MỤC</p><h2>Có thể bạn cũng thích</h2></div><a class="text-link" href="/products?category=<%= encodeURIComponent(product.category) %>">Xem thêm →</a></div>
      <div class="product-grid"><% related.forEach(item => { %><%- include('partials/product-card', { product: item }) %><% }) %></div>
    </section>
  <% } %>
</main>
<%- include('partials/foot') %>
