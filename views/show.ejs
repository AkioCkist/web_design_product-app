<%- include('partials/head') %>
<main id="main-content" class="shell page-space">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span>/</span><a href="/products">Products</a><span>/</span><span><%= product.name %></span>
  </nav>

  <section class="detail-layout">
    <div class="detail-media"><img src="<%= product.image %>" alt="<%= product.name %>"></div>
    <div class="detail-copy">
      <p class="eyebrow"><%= product.category %> / <%= product.sku %></p>
      <h1><%= product.name %></h1>
      <p class="detail-summary"><%= product.summary %></p>
      <p class="detail-price tabular"><%= formatVnd(product.price) %></p>
      <div class="availability"><span class="status-dot <%= product.quantity ? '' : 'is-out' %>"></span><%= product.quantity ? `${product.quantity} in stock` : 'Out of stock' %></div>
      <div class="detail-actions">
        <form action="/cart/items/<%= product._id %>" method="post"><input type="hidden" name="quantity" value="1"><button class="button button-dark" type="submit" <%= product.quantity ? '' : 'disabled' %>>Add to cart</button></form>
        <a class="button button-outline" href="/admin/products/<%= product._id %>/edit">Edit product</a>
      </div>
      <div class="detail-description">
        <h2>Design details</h2><p><%= product.description %></p>
      </div>
      <dl class="spec-list">
        <div><dt>Material</dt><dd><%= product.material %></dd></div>
        <div><dt>Colour</dt><dd><%= product.color %></dd></div>
        <div><dt>Dimensions</dt><dd><%= product.dimensions %></dd></div>
      </dl>
    </div>
  </section>

  <% if (related.length) { %>
    <section class="section related-section">
      <div class="section-heading"><div><p class="eyebrow">MORE TO CONSIDER</p><h2>You may also like</h2></div><a class="text-link" href="/products?category=<%= encodeURIComponent(product.category) %>">View more →</a></div>
      <div class="product-grid"><% related.forEach(item => { %><%- include('partials/product-card', { product: item }) %><% }) %></div>
    </section>
  <% } %>
</main>
<%- include('partials/foot') %>
