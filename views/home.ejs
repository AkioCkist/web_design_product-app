<%- include('partials/head') %>
<main id="main-content">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">NESTA / LIVING OBJECTS</p>
      <h1>Less, but<br>better.</h1>
      <p class="hero-lead">Furniture and objects selected to bring calm, purpose, and lasting beauty to the spaces you live in.</p>
      <div class="hero-actions">
        <a class="button button-dark" href="/products">Explore products</a>
        <a class="text-link" href="#collections">View collections <span aria-hidden="true">↘</span></a>
      </div>
      <div class="hero-proof">
        <span>Responsible materials</span><span>Curated design</span><span>Nationwide delivery</span>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-orbit" aria-hidden="true"></div>
      <img src="/uploads/nesta-arc-lamp.png" alt="Arc Table Lamp in warm ivory">
      <div class="feature-ticket">
        <span>Featured object</span>
        <strong>Arc</strong>
        <p>Soft light for quieter moments.</p>
        <a href="/products?category=Lighting" aria-label="View lighting products">↗</a>
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="featured-title">
    <div class="section-heading">
      <div><p class="eyebrow">MOST LOVED</p><h2 id="featured-title">Objects worth keeping</h2></div>
      <a class="text-link" href="/products">View all <span aria-hidden="true">→</span></a>
    </div>
    <% if (featured.length) { %>
      <div class="product-grid"><% featured.forEach(product => { %><%- include('partials/product-card', { product }) %><% }) %></div>
    <% } else { %>
      <div class="empty-state"><h3>No featured products yet</h3><p>Mark a product as featured in admin to show it here.</p><a class="button button-dark" href="/admin/products">Open admin</a></div>
    <% } %>
  </section>

  <section class="section shell" id="collections" aria-labelledby="collection-title">
    <div class="section-heading"><div><p class="eyebrow">SHOP BY SPACE</p><h2 id="collection-title">Find what your home needs</h2></div></div>
    <div class="category-grid">
      <% categories.forEach((item, index) => { %>
        <a class="category-card category-<%= index + 1 %>" href="/products?category=<%= encodeURIComponent(item) %>">
          <span class="category-index">0<%= index + 1 %></span>
          <div><h3><%= item %></h3><p><%= categoryCounts[item] || 0 %> <%= categoryCounts[item] === 1 ? 'product' : 'products' %></p></div>
          <span class="category-arrow" aria-hidden="true">↗</span>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="manifesto">
    <div class="shell manifesto-inner">
      <p class="eyebrow">THE NESTA PHILOSOPHY</p>
      <p class="manifesto-quote">A beautiful home does not need more things. It needs the <em>right</em> things—well made, long lasting, and quietly improving the everyday.</p>
      <a class="button button-light" href="/products">Start your edit</a>
    </div>
  </section>
</main>
<%- include('partials/foot') %>
