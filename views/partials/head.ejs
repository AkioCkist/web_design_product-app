<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="NESTA tuyển chọn nội thất và đồ gia dụng tối giản cho không gian sống hiện đại.">
  <title><%= title %> · NESTA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Bỏ qua đến nội dung</a>
  <div class="announcement">
    <div class="shell announcement-inner">
      <p>Miễn phí giao hàng cho đơn từ 2.000.000₫</p>
      <a href="/products">Khám phá bộ sưu tập <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <header class="site-header">
    <div class="shell nav-wrap">
      <a class="brand" href="/" aria-label="NESTA — Trang chủ">
        <span class="brand-mark" aria-hidden="true"></span>NESTA
      </a>
      <nav class="desktop-nav" aria-label="Điều hướng chính">
        <a class="<%= currentPath === '/' ? 'is-active' : '' %>" href="/">Trang chủ</a>
        <a class="<%= currentPath.startsWith('/products') ? 'is-active' : '' %>" href="/products">Sản phẩm</a>
        <a href="/#collections">Bộ sưu tập</a>
        <a class="<%= currentPath.startsWith('/admin') ? 'is-active' : '' %>" href="/admin/products">Quản lý</a>
      </nav>
      <div class="nav-actions">
        <a class="icon-button" href="/products" aria-label="Tìm kiếm sản phẩm">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
        </a>
        <a class="nav-cta" href="/products">Mua sắm</a>
        <details class="mobile-nav">
          <summary aria-label="Mở menu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </summary>
          <nav aria-label="Điều hướng di động">
            <a href="/">Trang chủ</a><a href="/products">Sản phẩm</a><a href="/#collections">Bộ sưu tập</a><a href="/admin/products">Quản lý</a>
          </nav>
        </details>
      </div>
    </div>
  </header>
