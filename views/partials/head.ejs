<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> – Kho sản phẩm</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="container d-flex align-items-center gap-3">
    <a href="/" class="brand">Kho sản phẩm</a>
    <form action="/search" method="GET" class="search ms-auto" role="search">
      <input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Tìm theo tên sản phẩm" aria-label="Tìm theo tên sản phẩm">
    </form>
    <a href="/add" class="btn btn-accent">Thêm sản phẩm</a>
  </div>
</header>
<main class="container py-5">
