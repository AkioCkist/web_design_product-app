<form action="<%= action %>" method="POST" enctype="multipart/form-data" class="form-panel">
  <div class="mb-4">
    <label for="name" class="form-label">Tên sản phẩm</label>
    <input id="name" type="text" name="name" class="form-control" value="<%= product ? product.name : '' %>" required>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-sm-6">
      <label for="price" class="form-label">Giá ($)</label>
      <input id="price" type="number" name="price" min="0" step="0.01" class="form-control" value="<%= product ? product.price : '' %>" required>
    </div>
    <div class="col-sm-6">
      <label for="quantity" class="form-label">Số lượng</label>
      <input id="quantity" type="number" name="quantity" min="0" step="1" class="form-control" value="<%= product ? product.quantity : '' %>" required>
    </div>
  </div>
  <div class="mb-4">
    <label for="image" class="form-label">Hình ảnh</label>
    <input id="image" type="file" name="image" accept="image/*" class="form-control" <%= product ? '' : 'required' %>>
    <% if (product) { %><div class="form-text">Để trống nếu muốn giữ hình hiện tại.</div><% } %>
    <img id="preview" class="preview" src="<%= product ? product.image : '' %>" alt="" <%- product ? '' : 'hidden' %>>
  </div>
  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-accent"><%= submit %></button>
    <a href="<%= cancel %>" class="btn btn-quiet">Hủy</a>
  </div>
</form>
<script>
  document.getElementById('image').addEventListener('change', function () {
    const img = document.getElementById('preview');
    if (this.files[0]) { img.src = URL.createObjectURL(this.files[0]); img.hidden = false; }
  });
</script>
