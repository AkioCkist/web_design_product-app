<div class="col">
  <div class="card product-card h-100">
    <a href="/products/<%= product._id %>"><img src="<%= product.image %>" class="card-img-top" alt="<%= product.name %>"></a>
    <div class="card-body d-flex flex-column">
      <h2 class="card-title"><%= product.name %></h2>
      <div class="d-flex justify-content-between align-items-baseline mb-3">
        <span class="price">$<%= product.price.toLocaleString('en-US') %></span>
        <span class="text-muted small">Còn <%= product.quantity %></span>
      </div>
      <div class="d-flex gap-2 mt-auto">
        <a href="/products/<%= product._id %>" class="btn btn-sm btn-accent">Chi tiết</a>
        <a href="/edit/<%= product._id %>" class="btn btn-sm btn-quiet">Sửa</a>
        <form action="/delete/<%= product._id %>" method="POST" class="ms-auto" onsubmit="return confirm('Xóa sản phẩm này?')">
          <button type="submit" class="btn btn-sm btn-danger-quiet">Xóa</button>
        </form>
      </div>
    </div>
  </div>
</div>
