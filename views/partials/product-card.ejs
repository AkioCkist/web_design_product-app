<article class="product-card">
  <a class="product-media" href="/products/<%= product._id %>">
    <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
    <% if (product.featured) { %><span class="product-badge">Tuyển chọn</span><% } %>
    <span class="card-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="product-copy">
    <div>
      <p class="product-category"><%= product.category %></p>
      <h3><a href="/products/<%= product._id %>"><%= product.name %></a></h3>
    </div>
    <p class="product-price"><%= formatVnd(product.price) %></p>
  </div>
</article>
