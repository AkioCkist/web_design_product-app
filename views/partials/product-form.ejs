<form class="product-form" action="<%= formAction %>" method="post" enctype="multipart/form-data">
  <section class="form-section">
    <div class="form-section-title"><span>01</span><div><h2>Thông tin cơ bản</h2><p>Tên, mã quản lý và mô tả sản phẩm.</p></div></div>
    <div class="form-fields">
      <div class="field full"><label for="name">Tên sản phẩm</label><input id="name" name="name" type="text" maxlength="120" required value="<%= product ? product.name : '' %>" placeholder="Ví dụ: Đèn bàn Arc"></div>
      <div class="field"><label for="sku">Mã SKU</label><input id="sku" name="sku" type="text" maxlength="40" required value="<%= product ? product.sku : '' %>" placeholder="NES-LGT-001"></div>
      <div class="field"><label for="category">Danh mục</label><select id="category" name="category" required><option value="" disabled <%= product ? '' : 'selected' %>>Chọn danh mục</option><% categories.forEach(item => { %><option value="<%= item %>" <%= product && product.category === item ? 'selected' : '' %>><%= item %></option><% }) %></select></div>
      <div class="field full"><label for="summary">Mô tả ngắn</label><input id="summary" name="summary" type="text" maxlength="180" required value="<%= product ? product.summary : '' %>" placeholder="Một câu giới thiệu ngắn gọn."><small>Hiển thị ở đầu trang chi tiết.</small></div>
      <div class="field full"><label for="description">Mô tả chi tiết</label><textarea id="description" name="description" rows="5" maxlength="1200" required placeholder="Câu chuyện, công năng và điểm đặc biệt của sản phẩm..."><%= product ? product.description : '' %></textarea></div>
    </div>
  </section>

  <section class="form-section">
    <div class="form-section-title"><span>02</span><div><h2>Giá & tồn kho</h2><p>Thông tin bán hàng và trạng thái hiển thị.</p></div></div>
    <div class="form-fields">
      <div class="field"><label for="price">Giá bán (₫)</label><input class="tabular" id="price" name="price" type="number" min="0" step="1000" required value="<%= product ? product.price : '' %>" placeholder="2390000"></div>
      <div class="field"><label for="quantity">Số lượng tồn</label><input class="tabular" id="quantity" name="quantity" type="number" min="0" step="1" required value="<%= product ? product.quantity : '' %>" placeholder="10"></div>
      <label class="checkbox-field full"><input type="checkbox" name="featured" <%= product && product.featured ? 'checked' : '' %>><span><strong>Sản phẩm nổi bật</strong><small>Hiển thị sản phẩm trên homepage.</small></span></label>
    </div>
  </section>

  <section class="form-section">
    <div class="form-section-title"><span>03</span><div><h2>Đặc tính</h2><p>Giúp khách hàng hiểu rõ sản phẩm.</p></div></div>
    <div class="form-fields">
      <div class="field"><label for="material">Chất liệu</label><input id="material" name="material" type="text" maxlength="100" required value="<%= product ? product.material : '' %>" placeholder="Gốm mờ, giấy xếp nếp"></div>
      <div class="field"><label for="color">Màu sắc</label><input id="color" name="color" type="text" maxlength="80" required value="<%= product ? product.color : '' %>" placeholder="Trắng ngà"></div>
      <div class="field full"><label for="dimensions">Kích thước</label><input id="dimensions" name="dimensions" type="text" maxlength="100" required value="<%= product ? product.dimensions : '' %>" placeholder="Ø 38 × C 42 cm"></div>
    </div>
  </section>

  <section class="form-section">
    <div class="form-section-title"><span>04</span><div><h2>Hình ảnh</h2><p>Ảnh vuông tối thiểu 1000px cho kết quả tốt nhất.</p></div></div>
    <div class="form-fields">
      <div class="upload-field full">
        <label for="image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0L7 9m5-5 5 5M5 14v5h14v-5"></path></svg><strong><%= product ? 'Chọn ảnh thay thế' : 'Tải ảnh sản phẩm lên' %></strong><span>PNG, JPG hoặc WEBP · tối đa 5MB</span></label>
        <input id="image" name="image" type="file" accept="image/*" <%= product ? '' : 'required' %>>
        <img id="image-preview" class="image-preview" src="<%= product ? product.image : '' %>" alt="Xem trước ảnh sản phẩm" <%= product ? '' : 'hidden' %>>
      </div>
    </div>
  </section>

  <div class="form-actions"><a class="button button-outline" href="/admin/products">Hủy</a><button class="button button-dark" type="submit"><%= submitLabel %></button></div>
</form>
